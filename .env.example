# Copy this file to .env and replace the placeholder values.
# Never commit the resulting .env file.
# Cada scripts/apply-*-route.sh lê daqui apenas as variáveis que lhe cabem.

# --- Comum (opcional) ---
# RATE_LIMIT_REQUESTS_PER_HOUR=2000

# --- scripts/apply-openai-route.sh ---
OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4o-mini

# --- scripts/apply-gemini-route.sh ---
GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-2.5-flash

# --- scripts/apply-deepseek-route.sh ---
DEEPSEEK_API_KEY=replace-me
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL_ALT=deepseek-chat

# --- scripts/apply-azure-route.sh (opcional: Azure OpenAI / Microsoft Foundry) ---
AZURE_MODEL=gpt-5-mini
AZURE_ENDPOINT_HOST=your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
# AZURE_API_VERSION=2025-03-01-preview
# AZURE_ROUTE=gpt-5-mini
